# ─────────────────────────────────────────────────────────────
# 配置模板。使用时复制成对应环境的文件名并填入真实值：
#   本地开发   → .env.development   （NODE_ENV=development）
#   自动化测试 → .env.test          （NODE_ENV=test）
#   测试服     → .env.staging       （NODE_ENV=staging）
#   正式服     → .env.production    （NODE_ENV=production）
#
# 切勿把真实密码 / 密钥写进本文件——它会进 Git。
# 加载逻辑见 src/config/env.js，设计理由见 docs/decisions.md ADR-011。
# ─────────────────────────────────────────────────────────────

# ── 运行环境 ──
# 必须与文件名后缀一致；同时需要在进程环境里设置（npm 脚本已内置 cross-env，
# 服务器在宝塔/pm2 的进程配置里设置）。缺失或值不在
# development/test/staging/production 之内，程序会直接报错退出。
NODE_ENV=

# Session Cookie 是否加 Secure 标志（加了之后浏览器只在 HTTPS 下回传）。
# true=加（HTTPS 环境）；false=不加（本地 HTTP 环境）。
# 缺失或值非法一律按 true 处理——本地忘了填就会"登不上"，立刻能发现，
# 而不是线上静默少了这个标志。
COOKIE_SECURE=

# ── MySQL ──
# DB_NAME / REDIS_DB 按环境取值，见 README.md「环境 ↔ 数据库 ↔ Redis 对照」：
#   development=photoer_development/0  test=photoer_test/15
#   staging=photoer_staging/1          production=photoer_production/0
# 库的字符集/排序规则必须是 utf8mb4 / utf8mb4_0900_ai_ci
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── 应用 ──
PORT=

# ── Redis ──
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
